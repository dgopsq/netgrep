{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/pkg",
      "!**/pkg-node",
      "!**/coverage",
      // The demo corpus: 56 public-domain text files, not source.
      "!packages/example/public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      // The demo's stylesheet is Tailwind v4, which is configured in CSS rather
      // than in a JS config file: `@theme`, `@utility` and `@custom-variant` are
      // real syntax there, and Biome rejects them as parse errors otherwise.
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // scripts/ holds CLI tools whose entire interface is stdout — both the
      // root ones and the demo's manifest generator.
      "includes": ["scripts/**", "packages/*/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
