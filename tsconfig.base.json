{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],

    // The published package is ESM-only and its relative imports already carry
    // explicit `.js` extensions, which is exactly what nodenext expects.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  }
}
