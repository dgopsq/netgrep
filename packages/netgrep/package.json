{
  "name": "@netgrep/netgrep",
  "version": "0.5.0",
  "description": "grep over HTTP — search a remote file with ripgrep's regex engine while it downloads",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgopsq/netgrep.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "imports": {
    "#wasm-boot": {
      "netgrep-source": "./src/lib/boot/fetch.ts",
      "types": "./dist/lib/boot/fetch.d.ts",
      "workerd": "./dist/lib/boot/workerd.js",
      "deno": "./dist/lib/boot/fetch.js",
      "node": "./dist/lib/boot/node.js",
      "default": "./dist/lib/boot/fetch.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@netgrep/search": "workspace:*"
  }
}
