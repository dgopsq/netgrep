{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn install)",
      "Bash(yarn --version)",
      "Bash(npx nx lint:*)",
      "Bash(npx nx test:*)",
      "Bash(npx nx build:*)",
      "Bash(npx nx run-many:*)",
      "Bash(npx nx show:*)",
      "Bash(npx nx graph:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo fmt --check:*)",
      "Bash(wasm-pack build:*)",
      "Bash(wasm-pack test:*)",
      "Bash(rustc --version)",
      "Bash(rustup show:*)",
      "Bash(rustup target list:*)",
      "Bash(rustup toolchain list:*)",
      "Bash(node --version)",
      "Bash(node scripts/post_build.js)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(wasm-pack publish:*)",
      "Bash(wasm-pack pack:*)",
      "Bash(cargo publish:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(npx nx publish:*)"
    ]
  }
}
