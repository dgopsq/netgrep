{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm build)",
      "Bash(pnpm build:wasm)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:wasm)",
      "Bash(pnpm verify:pack)",
      "Bash(pnpm dev)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm list:*)",
      "Bash(corepack pnpm:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo fmt --check:*)",
      "Bash(wasm-pack build:*)",
      "Bash(wasm-pack test:*)",
      "Bash(rustc --version)",
      "Bash(rustup show:*)",
      "Bash(rustup target list:*)",
      "Bash(rustup toolchain list:*)",
      "Bash(node --version)",
      "Bash(node scripts/verify-pack.mjs)",
      "Bash(node packages/search/scripts/post_build.js)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(wasm-pack publish:*)",
      "Bash(wasm-pack pack:*)",
      "Bash(cargo publish:*)",
      "Bash(git tag:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin --tags:*)"
    ]
  }
}
