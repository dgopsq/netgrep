{
  "name": "@netgrep/main",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "worktree": "node scripts/worktree.mjs",
    "build": "pnpm --filter @netgrep/netgrep build",
    "build:example": "pnpm --filter @netgrep/example build",
    "build:wasm": "pnpm --filter @netgrep/search build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:tools": "vitest run --project tools",
    "docs:sync": "node scripts/docs-sync.mjs",
    "test:browser": "vitest run --project browser",
    "test:node": "vitest run --project node",
    "test:deno": "deno run --allow-read --allow-net packages/netgrep/tests/deno-smoke.ts",
    "test:workerd": "vitest run -c vitest.workerd.config.ts",
    "test:rust": "pnpm --filter @netgrep/search test",
    "verify:pack": "node scripts/verify-pack.mjs",
    "lint": "pnpm lint:js && pnpm lint:rust",
    "lint:js": "biome check .",
    "lint:rust": "pnpm --filter @netgrep/search lint",
    "format": "biome check --write .",
    "typecheck": "tsc -p packages/netgrep/tsconfig.json",
    "typecheck:example": "tsc -p packages/example/tsconfig.json",
    "dev": "pnpm --filter @netgrep/example dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@types/node": "^26.1.2",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.62.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
